#version 330 core
out vec4 FragColor;

in VS_OUT {
    vec3 FragPos;
    vec2 TexCoords;
    vec3 TangentLightPos;
    vec3 TangentViewPos;
    vec3 TangentFragPos;
} fs_in;

uniform sampler2D diffuseMap;
uniform sampler2D normalMap;

uniform vec3 lightPos;
uniform vec3 viewPos;

uniform bool useNormalMap;
uniform int renderMode;

void main()
{
    vec3 normal;
    
    if (useNormalMap) {
        // ON: Usar normal mapping
        // Texturas guardam vetores em [0, 1], mas normais precisam de [-1, 1].
        // O "* 2.0 - 1.0" faz esse remapeamento.
        normal = texture(normalMap, fs_in.TexCoords).rgb;
        normal = normalize(normal * 2.0 - 1.0);  
    } else {
        // OFF: Usar normal padrão
        normal = vec3(0.0, 0.0, 1.0);
    }
   
    // get diffuse color
    vec3 color = texture(diffuseMap, fs_in.TexCoords).rgb;
    
    // ambient
    vec3 ambient = 0.1 * color;
    
    // Cálculo da luz no Tangent Space:
    // Como a normal (da textura) e os vetores de luz estão no mesmo espaço TBN,
    // o produto escalar (dot) resulta na iluminação correta do relevo.
    vec3 lightDir = normalize(fs_in.TangentLightPos - fs_in.TangentFragPos);
    float diff = max(dot(lightDir, normal), 0.0);
    vec3 diffuse = diff * color;
    
    // specular
    vec3 viewDir = normalize(fs_in.TangentViewPos - fs_in.TangentFragPos);
    vec3 reflectDir = reflect(-lightDir, normal);
    vec3 halfwayDir = normalize(lightDir + viewDir);  
    float spec = pow(max(dot(normal, halfwayDir), 0.0), 32.0);

    vec3 specular = vec3(0.2) * spec;

    if (renderMode == 1) {
        // Modo 1: Mostra apenas a textura de cor (sem luz nenhuma)
        FragColor = vec4(color, 1.0);
    } 
    else if (renderMode == 2) {
        // Modo 2: Mostra apenas o Normal Map puro (O mapa azul/roxo)
        // Precisamos remapear de [-1, 1] de volta para [0, 1] para o monitor conseguir mostrar as cores
        FragColor = vec4(normal * 0.5 + 0.5, 1.0);
    } 
    else if (renderMode == 3) {
        // Modo 3: Mostra apenas a Matemática da Luz!
        // A cor será definida puramente pelo Produto Escalar (dot product).
        // Superfícies viradas para a luz ficam brancas, contra a luz ficam pretas.
        FragColor = vec4(vec3(diff), 1.0);
    } 
    else {
        // Modo 0: Renderização completa e final
        FragColor = vec4(ambient + diffuse + specular, 1.0);
    }
}